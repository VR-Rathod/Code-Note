{
 ;; -------------------------
 ;; BASIC SETTINGS
 ;; -------------------------
 :ui/show-brackets? false
 :ui/show-command-doc? true
 :ui/show-empty-bullets? false
 :ui/show-page-title? true

 ;; -------------------------
 ;; WHITEBOARD SETTINGS
 ;; -------------------------
 :whiteboard/enabled? true
 :whiteboard/auto-open? false
 :whiteboard/grid? true
 :whiteboard/snap-to-grid? true
 :whiteboard/background-color "#0f172a"   ;; dark slate
 :whiteboard/card-background "#111827"
 :whiteboard/card-border-color "#334155"
 :whiteboard/card-text-color "#e5e7eb"
 :whiteboard/arrow-color "#38bdf8"

 ;; -------------------------
 ;; JOURNAL & TIME TRACKING
 ;; -------------------------
 :journals/enable? true
 :journals/default-template "daily-learning"
 :clock/enable? true

 ;; -------------------------
 ;; TASK WORKFLOW
 ;; -------------------------
 :task/markers ["TODO" "DOING" "LATER" "DONE"]
 :task/priority-colors
 { "A" "#ef4444"   ;; Red
   "B" "#f59e0b"   ;; Amber
   "C" "#22c55e" } ;; Green

 ;; -------------------------
 ;; LINKING & KNOWLEDGE GRAPH
 ;; -------------------------
 :graph/settings
 {:node-size 6
  :link-size 2
  :charge-strength -350
  :repulsion-strength 0.8}

 ;; -------------------------
 ;; EDITOR BEHAVIOR
 ;; -------------------------
 :editor/enable-block-timestamps? true
 :editor/preferred-format :org
 :editor/auto-save? true

 ;; -------------------------
 ;; PERFORMANCE & SAFETY
 ;; -------------------------
 :file-sync/enable? true
 :auto-pull-interval 300
}
